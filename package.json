{
  "name": "sistema-ugel",
  "version": "1.0.0",
  "description": "Proyecto unificado para ejecutar backend y frontend",
  "scripts": {
    "start:backend": "pnpm --filter ./backend start",
    "start:frontend": "pnpm --filter ./frontend start",
    "dev": "concurrently \"pnpm run start:backend\" \"pnpm run start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}