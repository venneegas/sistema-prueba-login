# Configuración de Base de Datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ugel_db
DB_USER=root
DB_PASSWORD=

# Configuración de servidor
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Credenciales de JWT (opcional)
JWT_SECRET=tu_clave_secreta_aqui

# Configuracion de correo SMTP
# Usado para recuperacion de contrasena, avisos de solicitudes y avisos de reportes enviados.
EMAIL_HOST=mail.tu-dominio.gob.pe
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=usuario@tu-dominio.gob.pe
EMAIL_PASS=tu_password_smtp
EMAIL_FROM=usuario@tu-dominio.gob.pe
EMAIL_FROM_NAME=Sistema UGEL

# URL publica del frontend para enlaces dentro de los correos
FRONTEND_URL=http://localhost:3000

# Notificaciones por correo al especialista
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_SPECIALIST_TO=especialista@ugel.edu.pe
